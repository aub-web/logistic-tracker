# Postgres connection string (e.g. from Neon — use the pooled "-pooler" host).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Direct (non-pooled — no "-pooler" in the host) connection string, used only
# for `prisma migrate deploy`/`migrate dev`. The pooled endpoint above doesn't
# support the session-level advisory lock migrations take, so build systems
# (e.g. Netlify) need this set separately. Falls back to DATABASE_URL if unset.
DIRECT_DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Numeric PIN required to log in to the tracker.
ADMIN_PIN="1234"

# Secret used to sign the admin session cookie. Generate with `openssl rand -hex 32`.
ADMIN_SESSION_SECRET="replace-with-a-long-random-value"

# --- Google Sheets sync -----------------------------------------------------
# The tracker reads each form's response Sheet via its public CSV export —
# no credentials needed, as long as the Sheet stays shared as "Anyone with
# the link can view" (Share button, top right, in the Sheet itself). If that
# sharing is ever locked down, the fetch in src/lib/google-sheets.ts is the
# one place that would need to switch to an authenticated Sheets API call.
#
# The gid identifies a specific tab (visible in the URL once that tab is
# selected, e.g. ".../edit?gid=1804606724") — use gid, not the tab name: a
# named Filter View can hide most rows from a name-based export without any
# error, silently under-syncing. gid-based export always reads the tab's real
# data regardless of any filter.

# Spreadsheet ID + tab gid behind the Device Request form (the "Form
# Responses 1" tab of "Device Request (Responses)-01").
GOOGLE_DEVICE_REQUEST_SPREADSHEET_ID="11OVzC0OtMRcIR47Yox7EjIzzTyemjvAauFziL1P_7To"
GOOGLE_DEVICE_REQUEST_SHEET_GID="1804606724"

# Same, for the Swapping Request form (the "Form Responses 1" tab of
# "Swapping Request (Responses)").
GOOGLE_SWAPPING_REQUEST_SPREADSHEET_ID="10c99kmnkPc7SDQxMTGW5W4QeeVGq2nGNDnzTfB6ZIOw"
GOOGLE_SWAPPING_REQUEST_SHEET_GID="115615290"

# Optional: lets an external cron service (e.g. cron-job.org, a GitHub
# Actions schedule) trigger a sync by POSTing to /api/sync with an
# `Authorization: Bearer <SYNC_SECRET>` header, so new form submissions show
# up without anyone clicking "Sync from Google Forms". Generate with
# `openssl rand -hex 32`. Leave unset to disable that endpoint.
SYNC_SECRET=""
