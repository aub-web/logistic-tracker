// Prisma schema for the Atlas Capture logistics tracker.
// Runs on Postgres (e.g. Neon) via the pg driver adapter — see
// src/lib/prisma.ts. Rows are pulled in from the Google Sheets behind the
// Device Request and Swapping Request forms — see src/lib/sync.ts.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RequestStatus {
  NEW
  IN_PROGRESS
  DISPATCHED
  CANCELLED
}

enum DeviceRequestType {
  DROP_OFF
  REPLACEMENT
  PULL_OUT
}

enum BusinessType {
  DIRECT_BUSINESS
  EXTERNAL_PARTNER
  OUTBOUND
}

model DeviceRequest {
  id String @id @default(cuid())

  // The sheet's own "Request ID" column (e.g. "REQ-0132"), assigned by the
  // existing Apps Script tracker. Used to dedupe on sync — stable even if
  // rows get sorted, filtered, or deleted, unlike a row number. Falls back
  // to a synthesized "ROW-<n>" id for older rows the tracker never stamped.
  requestId String @unique

  // "Timestamp" column Google Forms adds automatically.
  submittedAt DateTime @db.Timestamptz(3)

  requesterEmail String

  // Kept as raw form text (not parsed into a Date) since the sheet's date/time
  // columns are free-form display strings, not needed for sorting — submittedAt
  // already gives chronological order.
  requestDate String
  requestTime String

  requestType DeviceRequestType

  sdrName String
  ssName  String?

  businessType    BusinessType
  businessName    String
  businessAddress String
  contactPerson   String
  contactNumber   String

  deliveryMode String
  deviceType   String
  quantity     Int

  // "ADDITIONAL REQUEST DEVICE TYPE" / "QUANTITY FOR ADDITIONAL REQUEST" —
  // an SDR can ask for extra units of a device type beyond the primary
  // request on the same submission. Null when nothing was requested there.
  additionalRequestDeviceType String?
  additionalRequestQuantity   Int?

  // "*IF REPLACEMENT, PROVIDE THE ISSUE & TROUBLESHOOTING PERFORMED" — only
  // filled in when requestType is REPLACEMENT.
  replacementIssue String?

  status       RequestStatus @default(NEW)
  dispatchedAt DateTime?     @db.Timestamptz(3)

  // Name of whoever last changed `status` from the tracker UI (set at login,
  // not a full user account). Null until someone has touched it here.
  lastChangedBy String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([status])
}

// A row here means that business is in the Trash — hidden from every
// request table, filter, and Summary. Presence in this table IS the
// "deleted" state (there's no separate soft-delete flag); restoring just
// deletes the row. Deliberately not tied to DeviceRequest/SwappingRequest by
// foreign key, since businesses there are matched by exact name string, not
// an id.
model Business {
  id String @id @default(cuid())

  name      String   @unique
  deletedAt DateTime @default(now()) @db.Timestamptz(3)
  deletedBy String

  @@index([deletedAt])
}

// Manual record of extra SD cards the logistics team hands out for a
// business beyond the normal one-per-device allocation — there's no form
// field for this, so it's tagged directly in the tracker. Each row is one
// tagging event (not a running total), so who/when is preserved per entry;
// the total shown per business is the sum of these.
model ExtraSdCardEntry {
  id String @id @default(cuid())

  businessName String
  quantity     Int
  taggedBy     String
  taggedAt     DateTime @default(now()) @db.Timestamptz(3)

  @@index([businessName])
}

model SwappingRequest {
  id String @id @default(cuid())

  requestId   String   @unique
  submittedAt DateTime @db.Timestamptz(3)

  requesterEmail String

  swappingDate String
  swappingTime String

  sdrName String
  ssName  String?

  businessType    BusinessType
  businessName    String
  businessAddress String
  contactPerson   String
  contactNumber   String

  sdCardCount Int

  status       RequestStatus @default(NEW)
  dispatchedAt DateTime?     @db.Timestamptz(3)

  // Name of whoever last changed `status` from the tracker UI (set at login,
  // not a full user account). Null until someone has touched it here.
  lastChangedBy String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([status])
}
